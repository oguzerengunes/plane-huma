# Upstream compose'a dokunma, bunu override olarak kullan:
# docker compose -f docker-compose.yaml -f ../deploy/docker-compose.override.yml up -d
services:
  backup:
    image: minio/mc:latest
    container_name: huma-backup
    restart: unless-stopped
    env_file:
      - ../deploy/.env.huma
    volumes:
      - huma-backups:/backups
      - /var/run/docker.sock:/var/run/docker.sock:ro
    entrypoint: ["/bin/sh", "-c", "while true; do /scripts/backup.sh; sleep 86400; done"]
    networks:
      - plane-network
volumes:
  huma-backups:
